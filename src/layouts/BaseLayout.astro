---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'JADE — Graphic Designer',
  description = 'Portfolio of Jade, a graphic designer specializing in 平面設計 × UI/UX.',
} = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/base.css';
</style>
